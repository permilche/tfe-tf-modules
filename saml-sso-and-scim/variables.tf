# Required SAML Configuration

variable "idp_cert" {
  description = "Identity Provider Certificate - PEM encoded X.509 Certificate from Azure Entra ID"
  type        = string
  sensitive   = true
}

variable "sso_endpoint_url" {
  description = "Single Sign-On URL - HTTPS endpoint on Azure Entra ID for SSO requests (Login URL)"
  type        = string
}

variable "slo_endpoint_url" {
  description = "Single Log Out URL - HTTPS endpoint on Azure Entra ID for SLO requests (Logout URL)"
  type        = string
}

# SAML Feature Toggles

variable "debug" {
  description = "When sign-on fails and this is enabled, the SAMLResponse XML will be displayed on the login page"
  type        = bool
  default     = false
}

variable "authn_requests_signed" {
  description = "Ensure that <samlp:AuthnRequest> messages are signed"
  type        = bool
  default     = false
}

variable "want_assertions_signed" {
  description = "Ensure that <saml:Assertion> elements are signed"
  type        = bool
  default     = false
}

variable "team_management_enabled" {
  description = "Enable automatic team membership management via SAML attributes. Set to false to manage teams manually in TFE"
  type        = bool
  default     = true
}

# SAML Attribute Mappings

variable "attr_username" {
  description = "SAML attribute name that determines the user's username. For Azure Entra ID, typically 'http://schemas.xmlsoap.org/ws/2005/05/identity/claims/emailaddress'"
  type        = string
  default     = "http://schemas.xmlsoap.org/ws/2005/05/identity/claims/emailaddress"
}

variable "attr_groups" {
  description = "SAML attribute name that determines team membership. For Azure Entra ID with custom roles, use 'MemberOf'"
  type        = string
  default     = "MemberOf"
}

variable "attr_site_admin" {
  description = "SAML attribute name for site admin access. Overrides site_admin_role method"
  type        = string
  default     = null
}

variable "site_admin_role" {
  description = "Role name for site admin access from the Team Attribute. For Azure Entra ID, this would be a custom role value like 'site-admins'"
  type        = string
  default     = null
}

# Session and Security Settings

variable "sso_api_token_session_timeout" {
  description = "SSO session timeout in seconds. Defaults to 1209600 (14 days)"
  type        = number
  default     = 1209600
}

variable "signature_signing_method" {
  description = "Signature Signing Method. Must be either SHA1 or SHA256"
  type        = string
  default     = "SHA256"

  validation {
    condition     = contains(["SHA1", "SHA256"], var.signature_signing_method)
    error_message = "signature_signing_method must be either SHA1 or SHA256."
  }
}

variable "signature_digest_method" {
  description = "Signature Digest Method. Must be either SHA1 or SHA256"
  type        = string
  default     = "SHA256"

  validation {
    condition     = contains(["SHA1", "SHA256"], var.signature_digest_method)
    error_message = "signature_digest_method must be either SHA1 or SHA256."
  }
}

# Optional Advanced Configuration

variable "acs_consumer_url" {
  description = "ACS Consumer (Recipient) URL. Typically auto-generated by TFE"
  type        = string
  default     = null
}

variable "metadata_url" {
  description = "Metadata (Audience) URL. Typically auto-generated by TFE"
  type        = string
  default     = null
}

variable "certificate" {
  description = "Certificate used for request and assertion signing (optional)"
  type        = string
  default     = null
  sensitive   = true
}

variable "private_key" {
  description = "Private key used for request and assertion signing (optional)"
  type        = string
  default     = null
  sensitive   = true
}

variable "provider_type" {
  description = "Identity provider type. Valid values: okta, entra, saml, unknown"
  type        = string
  default     = "entra"

  validation {
    condition     = contains(["okta", "entra", "saml", "unknown"], var.provider_type)
    error_message = "provider_type must be one of: okta, entra, saml, unknown."
  }
}

# Break-glass Admin User Configuration

variable "create_break_glass_admin" {
  description = "Whether to output instructions for creating a break-glass admin user. Note: TFE provider does not support creating admin users via Terraform"
  type        = bool
  default     = false
}

variable "break_glass_admin_username" {
  description = "Username for the break-glass admin user (used in output instructions only)"
  type        = string
  default     = "break-glass-admin"
}

variable "break_glass_admin_email" {
  description = "Email for the break-glass admin user (used in output instructions only)"
  type        = string
  default     = null
}

# SCIM Configuration

variable "organization" {
  description = "Name of the TFE organization"
  type        = string
}

variable "enable_scim" {
  description = "Enable SCIM provisioning. When enabled, users and groups are automatically synced from your identity provider"
  type        = bool
  default     = false
}

variable "scim_token_rotation_days" {
  description = "Number of days before the SCIM token expires and needs to be rotated. Defaults to 90 days. Maximum allowed value is 365 days."
  type        = number
  default     = 90

  validation {
    condition     = var.scim_token_rotation_days > 0 && var.scim_token_rotation_days <= 365
    error_message = "scim_token_rotation_days must be between 1 and 365."
  }
}

variable "scim_token_description" {
  description = "Description for the SCIM token"
  type        = string
  default     = "SCIM provisioning token"
}

variable "scim_teams" {
  description = "List of SCIM team mappings. Each team maps an IdP group to a TFE team with the same name"
  type = list(object({
    group_name      = string
    team_name       = string
    team_visibility = optional(string, "organization")
    organization_access = optional(object({
      access_secret_teams         = optional(bool, false)
      read_workspaces             = optional(bool, false)
      read_projects               = optional(bool, false)
      manage_policies             = optional(bool, false)
      manage_policy_overrides     = optional(bool, false)
      delegate_policy_overrides   = optional(bool, false)
      manage_workspaces           = optional(bool, false)
      manage_vcs_settings         = optional(bool, false)
      manage_providers            = optional(bool, false)
      manage_modules              = optional(bool, false)
      manage_run_tasks            = optional(bool, false)
      manage_projects             = optional(bool, false)
      manage_membership           = optional(bool, false)
      manage_teams                = optional(bool, false)
      manage_organization_access  = optional(bool, false)
      manage_agent_pools          = optional(bool, false)
    }))
  }))
  default = []
}
